# Copy to .env (git-ignored) and fill in your Firebase web app values, then:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# These are client identifiers, not secrets, but keep them out of Git anyway.
# Never put service-account JSON, Admin SDK keys or keystore passwords here.
# Leave them empty to build without online play (offline and Bluetooth work).
FIREBASE_API_KEY=
# App ids: one per platform you registered in the Firebase console
# (Project settings > Your apps). FIREBASE_APP_ID is used where a
# platform-specific one is empty.
FIREBASE_APP_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_FUNCTIONS_REGION=us-central1
# Set to use the local emulators (10.0.2.2 from an Android emulator).
FIREBASE_EMULATOR_HOST=
# Rewarded ad units from your AdMob account. Empty = Google's test ads.
# (The AdMob *app* ids go to Gradle and Info.plist, see docs/STORE_RELEASE.md.)
ADMOB_REWARDED_ID=
ADMOB_REWARDED_ID_IOS=
